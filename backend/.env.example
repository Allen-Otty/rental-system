# Copy to .env and edit. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-use-a-long-random-string-of-50-plus-characters
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://rental:rental@localhost:5432/rental
# Comma-separated frontend origins (e.g. your Vercel domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# SMS: "console" prints OTPs to the log (dev only); "africastalking" sends real SMS
SMS_BACKEND=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Cloudinary (photos). Videos/ID documents are NOT stored here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private storage for landlord ID documents (outside any public path)
PRIVATE_MEDIA_ROOT=./private_media

# Default commission, percent of first month's rent (override per landlord)
DEFAULT_COMMISSION_PERCENT=0

# Email (signup confirmation links). Dev prints to the console; production needs a real SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mjakez <no-reply@yourdomain.com>
# Where the confirmation link points (your frontend's address)
FRONTEND_URL=http://localhost:3000

# Request fee (KES) and M-Pesa STK push. MPESA_BACKEND=mock fakes payments in dev.
REQUEST_FEE_KES=200
MPESA_BACKEND=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public https address of this API, and a long random string used inside the callback URL
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
