# Copy to .env and edit. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-use-a-long-random-string-of-50-plus-characters
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://rental:rental@localhost:5432/rental
# Comma-separated frontend origins (e.g. your Vercel domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# SMS: "console" prints OTPs to the log (dev only); "africastalking" sends real SMS
SMS_BACKEND=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Cloudinary (photos). Videos/ID documents are NOT stored here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private storage for landlord ID documents (outside any public path)
PRIVATE_MEDIA_ROOT=./private_media

# Default commission, percent of first month's rent (override per landlord)
DEFAULT_COMMISSION_PERCENT=0
